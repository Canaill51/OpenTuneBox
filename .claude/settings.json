{
  "permissions": {
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr merge*)",
      "Bash(git tag*)",
      "Bash(gh release*)",
      "Bash(gh workflow run*)",
      "Bash(gh api*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-docs.sh",
            "timeout": 60,
            "statusMessage": "Vérification de la documentation…"
          }
        ]
      }
    ]
  }
}
